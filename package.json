{
  "name": "sample-text",
  "productName": "sample-text",
  "version": "0.1.0",
  "description": "轻量、跨平台的文本处理与代码编辑工具，MIT 许可",
  "main": "./out/main/index.js",
  "author": "sample-text Contributors",
  "license": "MIT",
  "homepage": "https://github.com/Jack11843121/sample-text",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "electron-vite dev --rendererOnly",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "electron-vite build && electron-builder --mac --x64 --arm64",
    "build:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "build:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:win:zip": "electron-vite build && electron-builder --win zip --x64",
    "build:unpack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.11",
    "monaco-vim": "^0.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
